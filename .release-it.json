{
  "git": {
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "requireBranch": "release/v*",
    "requireCleanWorkingDir": true,
    "tag": false,
    "push": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true
    }
  },
  "hooks": {
    "before:init": "pnpm release:check",
    "after:bump": "pnpm install --lockfile-only && test \"$(git branch --show-current)\" = \"release/v${version}\"",
    "after:release": "echo Prepared release PR commit for ${name} v${version}"
  }
}

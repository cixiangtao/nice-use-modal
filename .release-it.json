{
  "hooks": {
    "before:init": "pnpm release:check"
  },
  "git": {
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "requireBranch": "master",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": true
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true
    }
  }
}

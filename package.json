{
  "name": "nice-use-modal",
  "version": "3.0.1",
  "description": "A React modal hook",
  "keywords": [
    "hook",
    "modal",
    "react",
    "ts",
    "typescript"
  ],
  "homepage": "https://github.com/cixiangtao/nice-use-modal",
  "license": "MIT",
  "author": "cixiangtao",
  "repository": {
    "type": "git",
    "url": "https://github.com/cixiangtao/nice-use-modal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build:demo": "vp build",
    "build:site": "node scripts/build-site.mjs",
    "build": "vp pack",
    "test": "vp test run --dom",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "preview": "vp preview",
    "release": "vp run build && release-it --only-version",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.6.7",
    "@mdx-js/rollup": "^2.3.0",
    "@release-it/conventional-changelog": "^7.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^5.8.2",
    "commitizen": "^4.2.5",
    "commitlint": "^17.6.7",
    "cz-git": "^1.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^8.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "release-it": "^16.3.0",
    "typescript": "^5.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.12.0"
}
